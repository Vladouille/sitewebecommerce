[
  {
    "name": "theme_info",
    "theme_name": "Studio Pilates",
    "theme_version": "1.0.0",
    "theme_author": "Ressaline",
    "theme_documentation_url": "https://help.shopify.com/fr/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/fr"
  },
  {
    "name": "Marque et contact",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "Nom de la marque",
        "default": "Ressaline",
        "info": "Utilisé dans les textes du site quand aucun logo n'est choisi."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Largeur du logo",
        "min": 60,
        "max": 260,
        "step": 10,
        "unit": "px",
        "default": 140
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Image carrée de 32 × 32 px minimum."
      },
      {
        "type": "text",
        "id": "phone",
        "label": "Téléphone affiché",
        "info": "À compléter : sans numéro, le téléphone est masqué partout sur le site."
      },
      {
        "type": "text",
        "id": "phone_hours",
        "label": "Horaires du téléphone",
        "default": "Du lundi au vendredi, 9 h – 18 h"
      },
      {
        "type": "text",
        "id": "email",
        "label": "Email affiché",
        "info": "À compléter : sans email, l'adresse est masquée partout sur le site."
      }
    ]
  },
  {
    "name": "Couleurs",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Fond principal (blanc cassé)",
        "default": "#FAF7F2"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Fond secondaire (beige)",
        "default": "#F0E8DC"
      },
      {
        "type": "color",
        "id": "color_wood",
        "label": "Bois clair (détails, bordures)",
        "default": "#D9C4A6"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Texte",
        "default": "#1E1C19"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Texte secondaire",
        "default": "#5C564E"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Couleur d'accent (boutons, liens)",
        "default": "#4E5B47",
        "info": "Choisis une couleur assez foncée pour que le texte des boutons reste lisible."
      },
      {
        "type": "color",
        "id": "color_buy",
        "label": "Boutons d'achat (Ajouter au panier, Passer commande)",
        "default": "#9A4A2C",
        "info": "Couleur réservée à l'achat : ne l'utilise nulle part ailleurs pour qu'elle reste repérable."
      },
      {
        "type": "color",
        "id": "color_buy_text",
        "label": "Texte des boutons d'achat",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_accent_text",
        "label": "Texte sur la couleur d'accent",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_dark",
        "label": "Fond foncé (barre du haut, pied de page)",
        "default": "#1E1C19"
      },
      {
        "type": "color",
        "id": "color_dark_text",
        "label": "Texte sur fond foncé",
        "default": "#F4EEE5"
      }
    ]
  },
  {
    "name": "Typographie",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Police des titres",
        "default": "cormorant_n5"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Police du texte",
        "default": "dm_sans_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Taille des titres",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "body_scale",
        "label": "Taille du texte",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Promesses",
    "settings": [
      {
        "type": "paragraph",
        "content": "Ces réglages pilotent les promesses affichées partout sur le site. Dans les textes des sections, écris [GARANTIE], [PIECES] ou [ECONOMIE] : ils sont remplacés automatiquement par les valeurs ci-dessous."
      },
      {
        "type": "header",
        "content": "Garantie"
      },
      {
        "type": "text",
        "id": "warranty_duration",
        "label": "Durée de la garantie commerciale",
        "default": "2 ans",
        "info": "Remplace [GARANTIE]. Elle doit correspondre exactement à ta page de conditions de garantie."
      },
      {
        "type": "header",
        "content": "Pièces de rechange"
      },
      {
        "type": "checkbox",
        "id": "parts_stock_france",
        "label": "Stock de pièces en France",
        "default": false,
        "info": "Coche seulement quand le stock existe réellement en France."
      },
      {
        "type": "text",
        "id": "parts_text_yes",
        "label": "Texte si le stock est en France",
        "default": "Pièces de rechange en stock en France"
      },
      {
        "type": "text",
        "id": "parts_text_no",
        "label": "Texte sinon",
        "default": "Pièces de rechange disponibles et garanties"
      },
      {
        "type": "header",
        "content": "Comparaison de prix"
      },
      {
        "type": "text",
        "id": "claim_savings",
        "label": "Promesse d'économie",
        "default": "jusqu'à 30 % moins cher",
        "info": "Remplace [ECONOMIE]. Laisse vide pour ne rien afficher. Garde une preuve datée de la comparaison."
      },
      {
        "type": "text",
        "id": "claim_savings_note",
        "label": "Mention sous la promesse",
        "default": "Par rapport aux prix publics constatés des marques de studio, [DATE À COMPLÉTER].",
        "info": "Affichée discrètement dans la bannière d'accueil, sous la promesse."
      }
    ]
  },
  {
    "name": "Prix et TVA",
    "settings": [
      {
        "type": "paragraph",
        "content": "Les prix sont saisis TTC dans Shopify. Le prix HT affiché est calculé : prix TTC ÷ (1 + taux de TVA). Ce calcul ne change pas le prix facturé."
      },
      {
        "type": "range",
        "id": "vat_rate",
        "label": "Taux de TVA",
        "min": 0,
        "max": 30,
        "step": 0.5,
        "unit": "%",
        "default": 20
      },
      {
        "type": "select",
        "id": "price_primary",
        "label": "Prix mis en avant",
        "options": [
          {
            "value": "ttc",
            "label": "TTC (recommandé si tu vends aussi aux particuliers)"
          },
          {
            "value": "ht",
            "label": "HT (si tu vends surtout aux professionnels)"
          }
        ],
        "default": "ttc"
      },
      {
        "type": "text",
        "id": "label_ttc",
        "label": "Libellé TTC",
        "default": "TTC"
      },
      {
        "type": "text",
        "id": "label_ht",
        "label": "Libellé HT",
        "default": "HT"
      }
    ]
  },
  {
    "name": "Cartes produit",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Format des images",
        "options": [
          {
            "value": "square",
            "label": "Carré"
          },
          {
            "value": "portrait",
            "label": "Portrait"
          },
          {
            "value": "landscape",
            "label": "Paysage"
          }
        ],
        "default": "landscape"
      },
      {
        "type": "checkbox",
        "id": "card_show_delivery",
        "label": "Afficher le badge de délai de livraison",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_secondary_image",
        "label": "Afficher la deuxième image au survol",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_add_to_cart",
        "label": "Afficher « Ajouter au panier » sur les cartes",
        "default": true,
        "info": "Pour les produits sans variantes. Les autres affichent « Choisir »."
      }
    ]
  },
  {
    "name": "Mise en page",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Largeur maximale de la page",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1320
      },
      {
        "type": "range",
        "id": "radius",
        "label": "Arrondi des angles",
        "min": 0,
        "max": 16,
        "step": 2,
        "unit": "px",
        "default": 2
      }
    ]
  },
  {
    "name": "Réseaux sociaux",
    "settings": [
      {
        "type": "paragraph",
        "content": "Laisse vide pour masquer un réseau."
      },
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram (adresse complète)"
      },
      {
        "type": "text",
        "id": "social_linkedin",
        "label": "LinkedIn (adresse complète)"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook (adresse complète)"
      }
    ]
  }
]
