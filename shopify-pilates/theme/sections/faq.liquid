{{ 'component-accordion.css' | asset_url | stylesheet_tag }}

<section class="section faq{% if section.settings.background == 'surface' %} section--surface{% endif %}" aria-labelledby="Faq-{{ section.id }}">
  <div class="page-width page-width--narrow">
    <div class="section-header section-header--center">
      <div>
        {%- if section.settings.heading_level == 'h1' -%}
          <h1 id="Faq-{{ section.id }}" class="section-heading">{% render 'tokens', text: section.settings.heading, escape: true %}</h1>
        {%- else -%}
          <h2 id="Faq-{{ section.id }}" class="section-heading">{% render 'tokens', text: section.settings.heading, escape: true %}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="section-text">{% render 'tokens', text: section.settings.text %}</div>
        {%- endif -%}
      </div>
    </div>

    <div class="accordion-group">
      {%- for block in section.blocks -%}
        <details class="accordion" {{ block.shopify_attributes }}>
          <summary class="accordion__summary">
            <span>{% render 'tokens', text: block.settings.question, escape: true %}</span>
            {% render 'icon', name: 'plus', class: 'accordion__icon' %}
          </summary>
          <div class="accordion__content rte">{% render 'tokens', text: block.settings.answer %}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "class": "section-faq",
  "max_blocks": 30,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Questions fréquentes"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Niveau du titre",
      "options": [
        { "value": "h2", "label": "Titre de section (page d'accueil)" },
        { "value": "h1", "label": "Titre principal (page FAQ)" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "default", "label": "Blanc cassé" },
        { "value": "surface", "label": "Beige" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Réponse", "default": "<p>Réponse.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "Quel est le délai de livraison ?", "answer": "<p>Le délai est indiqué sur chaque fiche produit. Les pièces et accessoires en stock partent rapidement. Les machines fabriquées à la commande sont livrées dans le délai annoncé sur la fiche.</p>" } },
        { "type": "question", "settings": { "question": "La livraison et le montage sont-ils vraiment inclus ?", "answer": "<p>Oui, en France métropolitaine. Nous livrons et montons vos machines dans votre studio. Hors France métropolitaine, contactez-nous avant de commander.</p>" } },
        { "type": "question", "settings": { "question": "Comment fonctionne la garantie ?", "answer": "<p>Les machines sont garanties [GARANTIE], selon les conditions détaillées sur la page Garantie. En cas de problème, contactez-nous : nous identifions la pièce en cause et organisons son remplacement.</p>" } },
        { "type": "question", "settings": { "question": "Recevrai-je une facture avec TVA ?", "answer": "<p>Oui. Chaque commande donne lieu à une facture avec la TVA détaillée, au nom de votre entreprise si vous le précisez lors de la commande.</p>" } },
        { "type": "question", "settings": { "question": "Y a-t-il des remises si j'achète plusieurs machines ?", "answer": "<p>Oui. Les remises par quantité sont indiquées sur chaque fiche produit et s'appliquent automatiquement dans le panier.</p>" } },
        { "type": "question", "settings": { "question": "Puis-je payer en plusieurs fois ?", "answer": "<p>Oui, pour les professionnels. Contactez-nous pour connaître les modalités adaptées à votre projet.</p>" } }
      ]
    }
  ]
}
{% endschema %}
