{{ 'section-comparison.css' | asset_url | stylesheet_tag }}

{%- assign brand = settings.brand_name -%}
{%- assign after_label = section.settings.after_label | replace: '[NOM DE MARQUE]', brand -%}

<section class="section comparison{% if section.settings.background == 'surface' %} section--surface{% endif %}" aria-labelledby="Comparison-{{ section.id }}">
  <div class="page-width">
    <div class="section-header section-header--center">
      <div>
        <h2 id="Comparison-{{ section.id }}" class="section-heading">{{ section.settings.heading | replace: '[NOM DE MARQUE]', brand | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="section-text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    </div>

    <div class="comparison__table-wrap">
      <table class="comparison__table">
        <caption class="visually-hidden">{{ section.settings.heading | replace: '[NOM DE MARQUE]', brand | escape }}</caption>
        <thead>
          <tr>
            <td></td>
            <th scope="col" class="comparison__col comparison__col--before">{{ section.settings.before_label | escape }}</th>
            <th scope="col" class="comparison__col comparison__col--after">{{ after_label | escape }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row" class="comparison__label">{{ block.settings.label | escape }}</th>
              <td class="comparison__before">
                <span class="comparison__mobile-label">{{ section.settings.before_label | escape }}</span>
                <span class="comparison__value">{% render 'icon', name: 'cross' %}<span>{{ block.settings.before | escape }}</span></span>
              </td>
              <td class="comparison__after">
                <span class="comparison__mobile-label">{{ after_label | escape }}</span>
                <span class="comparison__value">{% render 'icon', name: 'check' %}<span>{{ block.settings.after | escape }}</span></span>
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Avant / Avec",
  "class": "section-comparison",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Le circuit classique ou Ressaline",
      "info": "Astuce : écris [NOM DE MARQUE] pour afficher automatiquement le nom réglé dans Paramètres du thème."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Titre de la colonne « Avant »",
      "default": "Circuit classique"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "Titre de la colonne « Avec »",
      "default": "Avec Ressaline"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "default", "label": "Blanc cassé" },
        { "value": "surface", "label": "Beige" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Ligne",
      "settings": [
        { "type": "text", "id": "label", "label": "Critère", "default": "Critère" },
        { "type": "text", "id": "before", "label": "Avant", "default": "Ancienne situation" },
        { "type": "text", "id": "after", "label": "Avec", "default": "Nouvelle situation" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Avant / Avec",
      "blocks": [
        { "type": "row", "settings": { "label": "Prix", "before": "Marges de la marque et des distributeurs", "after": "Prix usine, jusqu'à 30 % moins cher" } },
        { "type": "row", "settings": { "label": "Délai", "before": "Devis et allers-retours avant même de commander", "after": "Prix affichés, commande en ligne, délai annoncé sur chaque fiche" } },
        { "type": "row", "settings": { "label": "SAV", "before": "Interlocuteurs multiples", "after": "Un contact direct en France, garantie 2 ans" } },
        { "type": "row", "settings": { "label": "Pièces", "before": "Commandées à l'étranger, longues à recevoir", "after": "Ressorts, sangles et poignées en stock en France" } }
      ]
    }
  ]
}
{% endschema %}
