{{ 'section-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign url_1 = section.settings.button_1_link | default: '/collections/packs-studio'
  assign url_2 = section.settings.button_2_link | default: '/collections/machines'
-%}

<section class="hero hero--{{ section.settings.layout }}{% if section.settings.image == blank %} hero--no-image{% endif %}" aria-labelledby="Hero-{{ section.id }}">
  <div class="page-width hero__inner">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero__eyebrow">{% render 'tokens', text: section.settings.eyebrow, escape: true %}</p>
      {%- endif -%}
      <h1 id="Hero-{{ section.id }}" class="hero__title">
        {%- render 'tokens', text: section.settings.heading, escape: true -%}
        {%- if settings.show_price_claim and settings.claim_savings != blank -%}
          , <span class="hero__claim">{{ settings.claim_savings | escape }}.</span>
        {%- elsif section.settings.heading_end != blank -%}
          , {% render 'tokens', text: section.settings.heading_end, escape: true %}.
        {%- endif -%}
      </h1>
      {%- if section.settings.text != blank -%}
        <div class="hero__text">{% render 'tokens', text: section.settings.text %}</div>
      {%- endif -%}
      <div class="hero__buttons">
        {%- if section.settings.button_1_label != blank -%}
          <a class="button button--primary" href="{{ url_1 }}">{% render 'tokens', text: section.settings.button_1_label, escape: true %}</a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="button button--secondary" href="{{ url_2 }}">{% render 'tokens', text: section.settings.button_2_label, escape: true %}</a>
        {%- endif -%}
      </div>
      {%- if settings.show_price_claim and settings.claim_savings != blank and settings.claim_savings_note != blank and settings.claim_savings_date != blank -%}
        <p class="hero__note">{{ settings.claim_savings_note | escape }}, {{ settings.claim_savings_date | escape }}.</p>
      {%- endif -%}
    </div>

    <div class="hero__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 2000
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '450, 750, 1000, 1400, 2000',
            sizes: '(min-width: 990px) 55vw, 100vw',
            alt: section.settings.image.alt | default: section.settings.image_alt,
            class: 'hero__image'
        }}
      {%- else -%}
        <div class="hero__drawing">{% render 'reformer-drawing' %}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bannière principale",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Photo d'un studio équipé, en lumière naturelle. 2000 px de large conseillés. Sans photo, un dessin de reformer s'affiche."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texte alternatif de l'image",
      "default": "Reformers Pilates installés dans un studio lumineux",
      "info": "Décris la photo pour les personnes malvoyantes et pour Google. Utilisé si l'image n'a pas déjà de texte alternatif."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Disposition",
      "options": [
        { "value": "split", "label": "Texte à gauche, image à droite" },
        { "value": "overlay", "label": "Texte sur l'image" }
      ],
      "default": "split"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit texte au-dessus du titre",
      "default": "Reformers, Cadillac et chaises"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Équipement Pilates de qualité studio"
    },
    {
      "type": "text",
      "id": "heading_end",
      "label": "Fin du titre (sans argument de prix)",
      "default": "prix affichés",
      "info": "Affichée après une virgule quand l'argument de prix est désactivé dans Paramètres du thème > Promesses. Sinon, la promesse d'économie la remplace."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Sous-titre",
      "default": "<p>Reformers, Cadillac et chaises importés directement de l'usine, sans distributeur intermédiaire. Garantie [GARANTIE]. Livraison et montage inclus.</p>"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Bouton principal : texte",
      "default": "Équiper mon studio"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Bouton principal : lien",
      "info": "Par défaut : la collection Packs studio."
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Bouton secondaire : texte",
      "default": "Voir les machines"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Bouton secondaire : lien",
      "info": "Par défaut : la collection Machines."
    }
  ],
  "presets": [{ "name": "Bannière principale" }]
}
{% endschema %}
