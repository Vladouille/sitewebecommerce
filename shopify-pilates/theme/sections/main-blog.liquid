{{ 'section-content.css' | asset_url | stylesheet_tag }}

<div class="section">
  <div class="page-width page-width--narrow">
    <h1 class="content-page__title">{{ blog.title | escape }}</h1>
    {%- paginate blog.articles by 12 -%}
      {%- if blog.articles.size > 0 -%}
        <ul class="article-list" role="list">
          {%- for article in blog.articles -%}
            <li class="article-list__item">
              {%- if article.image -%}
                <a href="{{ article.url }}" tabindex="-1" aria-hidden="true">
                  {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 600, 900', sizes: '(min-width: 750px) 700px, 100vw', alt: '' }}
                </a>
              {%- endif -%}
              <h2 class="article-list__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
              <p class="article-list__date">{{ article.published_at | time_tag: format: 'date' }}</p>
              <p>{{ article.excerpt_or_content | strip_html | truncatewords: 35 }}</p>
            </li>
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <p>{{ 'blogs.empty' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog",
  "class": "section-main-blog"
}
{% endschema %}
