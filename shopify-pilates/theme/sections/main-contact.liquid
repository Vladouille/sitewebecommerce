{{ 'section-content.css' | asset_url | stylesheet_tag }}

{%- assign phone_tel = settings.phone | remove: ' ' | remove: '.' | remove: '-' -%}

<section class="section contact-page" aria-labelledby="Contact-{{ section.id }}">
  <div class="page-width contact-page__inner">
    <div class="contact-page__intro">
      <h1 id="Contact-{{ section.id }}" class="content-page__title">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="rte">{{ section.settings.text }}</div>
      {%- endif -%}
      <ul class="contact-page__direct" role="list">
        {%- if settings.phone != blank -%}
          <li><a href="tel:{{ phone_tel }}">{% render 'icon', name: 'phone' %}<span>{{ settings.phone | escape }}</span></a></li>
        {%- endif -%}
        {%- if settings.email != blank -%}
          <li><a href="mailto:{{ settings.email }}">{% render 'icon', name: 'mail' %}<span>{{ settings.email | escape }}</span></a></li>
        {%- endif -%}
        {%- if settings.phone_hours != blank -%}
          <li class="contact-page__hours">{% render 'icon', name: 'clock' %}<span>{{ settings.phone_hours | escape }}</span></li>
        {%- endif -%}
      </ul>
    </div>

    <div class="contact-page__form">
      {%- form 'contact', id: 'ContactForm', class: 'form' -%}
        {%- if form.posted_successfully? -%}
          <p class="form__message form__message--success" role="status" tabindex="-1" autofocus>{% render 'icon', name: 'check' %} {{ 'contact.success' | t }}</p>
        {%- elsif form.errors -%}
          <div class="form__message form__message--error" role="alert" tabindex="-1" autofocus>
            <p>{{ 'contact.error' | t }}</p>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="form__field">
          <label for="ContactForm-name">{{ 'contact.name' | t }}</label>
          <input id="ContactForm-name" type="text" name="contact[{{ 'contact.name' | t }}]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
        </div>
        <div class="form__field">
          <label for="ContactForm-company">{{ 'contact.company' | t }}</label>
          <input id="ContactForm-company" type="text" name="contact[{{ 'contact.company' | t }}]" autocomplete="organization">
        </div>
        <div class="form__field">
          <label for="ContactForm-email">{{ 'contact.email' | t }} <span aria-hidden="true">*</span></label>
          <input id="ContactForm-email" type="email" name="contact[email]" autocomplete="email" required aria-required="true" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
        </div>
        <div class="form__field">
          <label for="ContactForm-phone">{{ 'contact.phone' | t }}</label>
          <input id="ContactForm-phone" type="tel" name="contact[{{ 'contact.phone' | t }}]" autocomplete="tel" value="{{ form.phone }}">
        </div>
        <div class="form__field">
          <label for="ContactForm-body">{{ 'contact.message' | t }}</label>
          <textarea id="ContactForm-body" name="contact[body]" rows="6">{{ form.body }}</textarea>
        </div>
        <p class="form__privacy">{{ section.settings.privacy_text | escape }}</p>
        <button type="submit" class="button button--primary">{{ 'contact.send' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Formulaire de contact",
  "class": "section-main-contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Contact" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Une question sur une machine, un projet d'ouverture de studio ou une commande en cours ? Écrivez-nous ou appelez-nous, nous vous répondons directement.</p>"
    },
    {
      "type": "text",
      "id": "privacy_text",
      "label": "Mention données personnelles",
      "default": "Vos informations servent uniquement à répondre à votre demande. Détails dans notre politique de confidentialité."
    }
  ]
}
{% endschema %}
