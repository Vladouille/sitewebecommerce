{{ 'section-content.css' | asset_url | stylesheet_tag }}

<div class="section content-page content-page--center">
  <div class="page-width page-width--narrow">
    <p class="header__logo-text">{{ settings.brand_name | escape }}</p>
    <h1 class="content-page__title">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}
      <p>{{ shop.password_message }}</p>
    {%- endif -%}
    {%- form 'storefront_password', class: 'password-form' -%}
      {%- if form.errors -%}
        <p class="form__message form__message--error" role="alert">{{ 'password.error' | t }}</p>
      {%- endif -%}
      <div class="form__field">
        <label for="Password">{{ 'password.label' | t }}</label>
        <input type="password" name="password" id="Password" autocomplete="current-password" required>
      </div>
      <button type="submit" class="button button--primary">{{ 'password.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Page mot de passe",
  "class": "section-main-password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ouverture prochaine" }
  ]
}
{% endschema %}
