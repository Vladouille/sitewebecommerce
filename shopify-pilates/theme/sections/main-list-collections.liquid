{{ 'component-card.css' | asset_url | stylesheet_tag }}

<div class="section">
  <div class="page-width">
    <h1 class="section-heading">{% render 'tokens', text: section.settings.heading, escape: true %}</h1>
    <ul class="product-grid product-grid--3" role="list">
      {%- for collection in collections -%}
        {%- if collection.handle != 'frontpage' and collection.products_count > 0 -%}
          <li>
            <article class="card card--{{ settings.card_image_ratio }}">
              <a class="card__link" href="{{ collection.url }}">
                <div class="card__media">
                  {%- assign image = collection.featured_image | default: collection.products.first.featured_media -%}
                  {%- if image -%}
                    {{ image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 33vw, 100vw', alt: collection.title, class: 'card__image' }}
                  {%- else -%}
                    {% render 'media-fallback' %}
                  {%- endif -%}
                </div>
                <div class="card__body">
                  <h2 class="card__title">{{ collection.title | escape }}</h2>
                  <p class="card__meta">{{ 'collections.product_count' | t: count: collection.products_count }}</p>
                </div>
              </a>
            </article>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Liste des collections",
  "class": "section-main-list-collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Catalogue" }
  ]
}
{% endschema %}
