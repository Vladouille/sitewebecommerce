{{ 'section-steps.css' | asset_url | stylesheet_tag }}

<section class="section steps{% if section.settings.background == 'surface' %} section--surface{% endif %}" aria-labelledby="Steps-{{ section.id }}">
  <div class="page-width">
    <div class="section-header section-header--center">
      <div>
        <h2 id="Steps-{{ section.id }}" class="section-heading">{% render 'tokens', text: section.settings.heading, escape: true %}</h2>
        {%- if section.settings.text != blank -%}
          <div class="section-text">{% render 'tokens', text: section.settings.text %}</div>
        {%- endif -%}
      </div>
    </div>
    <ol class="steps__list" role="list">
      {%- for block in section.blocks -%}
        <li class="steps__item" {{ block.shopify_attributes }}>
          <span class="steps__number" aria-hidden="true">{{ forloop.index }}</span>
          <h3 class="steps__title">{% render 'tokens', text: block.settings.title, escape: true %}</h3>
          {%- if block.settings.text != blank -%}
            <div class="steps__text">{% render 'tokens', text: block.settings.text %}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Comment ça marche",
  "class": "section-steps",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Comment ça marche"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "default", "label": "Blanc cassé" },
        { "value": "surface", "label": "Beige" }
      ],
      "default": "surface"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Étape"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texte"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comment ça marche",
      "blocks": [
        { "type": "step", "settings": { "title": "Vous commandez en ligne", "text": "<p>Prix affichés, paiement sécurisé. Une question ? Appelez-nous avant de commander.</p>" } },
        { "type": "step", "settings": { "title": "Fabrication et contrôle", "text": "<p>Votre commande est fabriquée par notre usine partenaire, contrôlée, puis expédiée. Le délai est annoncé sur chaque fiche produit.</p>" } },
        { "type": "step", "settings": { "title": "Livraison et montage dans votre studio", "text": "<p>Nos équipes livrent et montent vos machines. Vous n'avez plus qu'à ouvrir vos cours.</p>" } }
      ]
    }
  ]
}
{% endschema %}
