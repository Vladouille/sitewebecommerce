{%- comment -%}
  Produits complémentaires : produits d'une collection choisie (par défaut « accessoires-et-pieces »),
  hors produit affiché. Aucun appel externe, aucune fausse urgence.
{%- endcomment -%}
{%- liquid
  assign source = section.settings.collection
  if source == blank and section.settings.collection_handle != blank
    assign source = collections[section.settings.collection_handle]
  endif
  assign shown = 0
-%}
{%- if source != blank and source.products_count > 0 -%}
  {%- capture items -%}
    {%- for item in source.products -%}
      {%- if item.id != product.id and shown < section.settings.limit -%}
        {%- assign shown = shown | plus: 1 -%}
        <li>{% render 'product-card', product: item %}</li>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if shown > 0 -%}
    {{ 'component-card.css' | asset_url | stylesheet_tag }}
    <section class="section complementary" aria-labelledby="Complementary-{{ section.id }}">
      <div class="page-width">
        <div class="section-header">
          <div>
            <h2 id="Complementary-{{ section.id }}" class="section-heading">{% render 'tokens', text: section.settings.heading, escape: true %}</h2>
          </div>
          <a class="link-arrow" href="{{ source.url }}">{% render 'tokens', text: section.settings.view_all_label, escape: true %}</a>
        </div>
        <ul class="product-grid product-grid--4" role="list">
          {{ items }}
        </ul>
      </div>
    </section>
  {%- endif -%}
{%- elsif request.design_mode -%}
  <div class="page-width"><p class="editor-notice">{{ 'sections.featured_collection.empty_editor' | t }}</p></div>
{%- endif -%}

{% schema %}
{
  "name": "Produits complémentaires",
  "class": "section-complementary",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Accessoires et pièces" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "text",
      "id": "collection_handle",
      "label": "Ou identifiant de la collection",
      "default": "accessoires-et-pieces"
    },
    { "type": "range", "id": "limit", "label": "Nombre de produits", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "view_all_label", "label": "Texte du lien", "default": "Voir tout" }
  ],
  "presets": [{ "name": "Produits complémentaires" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
