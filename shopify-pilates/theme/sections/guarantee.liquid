{{ 'section-guarantee.css' | asset_url | stylesheet_tag }}

<section class="section guarantee{% if section.settings.background == 'surface' %} section--surface{% endif %}{% if section.settings.image == blank %} guarantee--no-image{% endif %}" aria-labelledby="Guarantee-{{ section.id }}">
  <div class="page-width guarantee__inner">
    {%- if section.settings.image != blank -%}
      <div class="guarantee__media">
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            widths: '450, 750, 1000, 1400',
            sizes: '(min-width: 990px) 45vw, 100vw',
            class: 'guarantee__image'
        }}
      </div>
    {%- endif -%}
    <div class="guarantee__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{% render 'tokens', text: section.settings.eyebrow, escape: true %}</p>
      {%- endif -%}
      <h2 id="Guarantee-{{ section.id }}" class="section-heading" data-split>{% render 'tokens', text: section.settings.heading, escape: true %}</h2>
      {%- if section.settings.text != blank -%}
        <div class="section-text">{% render 'tokens', text: section.settings.text %}</div>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="check-list" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              {% render 'icon', name: 'check' %}
              <span>{% render 'tokens', text: block.settings.text, escape: true %}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="button button--secondary" href="{{ section.settings.button_link }}">{% render 'tokens', text: section.settings.button_label, escape: true %}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Garantie et SAV",
  "class": "section-guarantee",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Petit libellé", "default": "Garantie et service après-vente" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (facultatif)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Garantie [GARANTIE] et service après-vente"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Un studio ne peut pas se permettre une machine à l'arrêt. Un interlocuteur vous répond directement et suit votre demande jusqu'à la remise en service. Ce qui est couvert est détaillé dans les conditions de garantie.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Lire les conditions de garantie"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton",
      "info": "Par exemple la page Garantie et pièces de rechange."
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "default", "label": "Blanc cassé" },
        { "value": "surface", "label": "Beige" }
      ],
      "default": "surface"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Point de garantie" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Garantie et SAV",
      "blocks": [
        { "type": "point", "settings": { "text": "Machines garanties [GARANTIE], selon les conditions de garantie" } },
        { "type": "point", "settings": { "text": "[PIECES]" } },
        { "type": "point", "settings": { "text": "Un interlocuteur unique pour le SAV" } },
        { "type": "point", "settings": { "text": "Livraison et montage inclus en France métropolitaine" } }
      ]
    }
  ]
}
{% endschema %}
