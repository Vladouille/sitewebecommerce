{{ 'component-card.css' | asset_url | stylesheet_tag }}
{%- if section.settings.style == 'large' -%}
  {{ 'component-feature-row.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- liquid
  assign featured = section.settings.collection
  if featured == blank and section.settings.collection_handle != blank
    assign featured = collections[section.settings.collection_handle]
  endif
-%}

<section class="section featured-collection{% if section.settings.background == 'surface' %} section--surface{% endif %}" aria-labelledby="Featured-{{ section.id }}">
  <div class="page-width">
    <div class="section-header">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{% render 'tokens', text: section.settings.eyebrow, escape: true %}</p>
        {%- endif -%}
        <h2 id="Featured-{{ section.id }}" class="section-heading" data-split>{% render 'tokens', text: section.settings.heading, escape: true %}</h2>
        {%- if section.settings.text != blank -%}
          <div class="section-text">{% render 'tokens', text: section.settings.text %}</div>
        {%- endif -%}
      </div>
      {%- if section.settings.show_view_all and featured != blank and featured.products_count > 0 -%}
        <a class="link-arrow" href="{{ featured.url }}">{% render 'tokens', text: section.settings.view_all_label, escape: true %}</a>
      {%- endif -%}
    </div>

    {%- if featured != blank and featured.products_count > 0 and section.settings.style == 'large' -%}
      <ul class="feature-rows" role="list">
        {%- for product in featured.products limit: section.settings.limit -%}
          <li>{% render 'feature-row', product: product, flip: forloop.index0 %}</li>
        {%- endfor -%}
      </ul>
    {%- elsif featured != blank and featured.products_count > 0 -%}
      <ul class="product-grid product-grid--{{ section.settings.columns }}" role="list">
        {%- for product in featured.products limit: section.settings.limit -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p class="editor-notice">{{ 'sections.featured_collection.empty_editor' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection en avant",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Présentation",
      "options": [
        { "value": "grid", "label": "Grille de cartes" },
        { "value": "large", "label": "Grandes images, une par ligne" }
      ],
      "default": "grid"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit libellé"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Nos machines"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "collection_handle",
      "label": "Ou identifiant de la collection",
      "info": "Utilisé si aucune collection n'est choisie au-dessus. Exemples : machines, packs-studio, accessoires-et-pieces.",
      "default": "machines"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Nombre de produits",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Colonnes sur ordinateur",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Afficher le lien « Voir tout »",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Texte du lien",
      "default": "Voir tout"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "default", "label": "Blanc cassé" },
        { "value": "surface", "label": "Beige" }
      ],
      "default": "default"
    }
  ],
  "presets": [{ "name": "Collection en avant" }]
}
{% endschema %}
