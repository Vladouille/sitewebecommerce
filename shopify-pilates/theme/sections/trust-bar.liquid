{{ 'section-trust-bar.css' | asset_url | stylesheet_tag }}

<section class="trust-bar{% if section.settings.background == 'surface' %} trust-bar--surface{% endif %}"{% if section.settings.heading != blank %} aria-labelledby="Trust-{{ section.id }}"{% else %} aria-label="{{ 'sections.trust.label' | t }}"{% endif %}>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 id="Trust-{{ section.id }}" class="section-heading">{% render 'tokens', text: section.settings.heading, escape: true %}</h2>
    {%- endif -%}
    <ul class="trust-bar__list" role="list">
      {%- for block in section.blocks -%}
        <li class="trust-bar__item" {{ block.shopify_attributes }}>
          <span class="trust-bar__icon">{% render 'icon', name: block.settings.icon %}</span>
          <div>
            <p class="trust-bar__title">
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{% render 'tokens', text: block.settings.title, escape: true %}</a>
              {%- else -%}
                {% render 'tokens', text: block.settings.title, escape: true %}
              {%- endif -%}
            </p>
            {%- if block.settings.text != blank -%}
              <p class="trust-bar__text">{% render 'tokens', text: block.settings.text, escape: true %}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Bandeau d'arguments",
  "class": "section-trust-bar",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre (facultatif)"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "default", "label": "Blanc cassé" },
        { "value": "surface", "label": "Beige" }
      ],
      "default": "surface"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Argument",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "tag", "label": "Étiquette prix" },
            { "value": "euro", "label": "Euro" },
            { "value": "shield", "label": "Bouclier (garantie)" },
            { "value": "wrench", "label": "Clé (pièces, SAV)" },
            { "value": "truck", "label": "Camion (livraison)" },
            { "value": "box", "label": "Colis" },
            { "value": "card", "label": "Carte bancaire" },
            { "value": "invoice", "label": "Facture" },
            { "value": "phone", "label": "Téléphone" },
            { "value": "studio", "label": "Studio" },
            { "value": "clock", "label": "Horloge" },
            { "value": "check", "label": "Coche" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Argument"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien (facultatif)",
          "info": "Par exemple vers la page des conditions de garantie."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bandeau d'arguments",
      "blocks": [
        { "type": "item", "settings": { "icon": "box", "title": "Importé de l'usine", "text": "Sans distributeur intermédiaire." } },
        { "type": "item", "settings": { "icon": "shield", "title": "Garantie [GARANTIE]", "text": "Voir les conditions de garantie." } },
        { "type": "item", "settings": { "icon": "wrench", "title": "[PIECES]", "text": "Ressorts, sangles, poignées." } },
        { "type": "item", "settings": { "icon": "truck", "title": "Livraison et montage inclus", "text": "En France métropolitaine." } }
      ]
    }
  ]
}
{% endschema %}
