{%- comment -%}
  Icônes SVG intégrées (aucune dépendance externe).
  Usage : {% render 'icon', name: 'truck' %}
  Noms : tag, shield, wrench, truck, phone, mail, check, cross, card, clock, studio,
         cart, menu, close, plus, minus, chevron, invoice, euro, heart, search, user, box
{%- endcomment -%}
<svg class="icon icon-{{ name }}{% if class %} {{ class }}{% endif %}" aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  {%- case name -%}
    {%- when 'tag' -%}
      <path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8Z"/><circle cx="7.5" cy="7.5" r="1.5"/>
    {%- when 'shield' -%}
      <path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6L12 3Z"/><path d="m8.8 12 2.2 2.2 4.2-4.4"/>
    {%- when 'wrench' -%}
      <path d="M14.7 6.3a4 4 0 0 0-5.4 5.1L3.6 17.1a1.5 1.5 0 0 0 2.1 2.1l5.7-5.7a4 4 0 0 0 5.1-5.4l-2.4 2.4-2.1-.6-.6-2.1 2.4-2.4Z"/>
    {%- when 'truck' -%}
      <path d="M2.5 6.5h11v9h-11z"/><path d="M13.5 9.5h4l3 3v3h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'phone' -%}
      <path d="M21 16.4v2.8a1.9 1.9 0 0 1-2 1.9A18.8 18.8 0 0 1 2.9 5 1.9 1.9 0 0 1 4.8 3h2.8a1.9 1.9 0 0 1 1.9 1.6c.1.9.4 1.8.7 2.7a1.9 1.9 0 0 1-.4 2L8.6 10.5a15 15 0 0 0 4.9 4.9l1.2-1.2a1.9 1.9 0 0 1 2-.4c.9.3 1.8.6 2.7.7a1.9 1.9 0 0 1 1.6 1.9Z"/>
    {%- when 'mail' -%}
      <rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="m3.5 6 8.5 7 8.5-7"/>
    {%- when 'check' -%}
      <path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'cross' -%}
      <path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'card' -%}
      <rect x="2.5" y="5" width="19" height="14" rx="1.5"/><path d="M2.5 9.5h19M6 15h4"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
    {%- when 'studio' -%}
      <path d="M3 20.5h18M5 20.5V9l7-5 7 5v11.5"/><path d="M9.5 20.5v-5h5v5"/>
    {%- when 'cart' -%}
      <path d="M3 4h2l2.2 11.2a1.5 1.5 0 0 0 1.5 1.3h8.6a1.5 1.5 0 0 0 1.5-1.2L20.5 8H6"/><circle cx="9.5" cy="20" r="1.2"/><circle cx="17" cy="20" r="1.2"/>
    {%- when 'menu' -%}
      <path d="M3.5 7h17M3.5 12h17M3.5 17h17"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'chevron' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'invoice' -%}
      <path d="M6 2.5h9l4 4V21.5H6z"/><path d="M14.5 2.5v4.5H19M9 11h7M9 14.5h7M9 18h4"/>
    {%- when 'euro' -%}
      <path d="M17.5 6.5A7 7 0 1 0 17.5 17.5"/><path d="M4 10.5h9M4 13.5h9"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7.5-4.5-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.5-7.5 10-7.5 10Z"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.4-4.4"/>
    {%- when 'user' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>
    {%- when 'box' -%}
      <path d="M21 8 12 3 3 8v8l9 5 9-5V8Z"/><path d="m3 8 9 5 9-5M12 13v8"/>
    {%- else -%}
      <circle cx="12" cy="12" r="3"/>
  {%- endcase -%}
</svg>
