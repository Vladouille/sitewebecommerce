# Mot de passe du site (10 caractères minimum). Choisis-en un long et unique.
BOT_PASSWORD=

# Ton nom de domaine (option A du README), par exemple monbot.duckdns.org
DOMAIN=

# Mets 0 seulement pour tester en http://localhost sans HTTPS
SECURE_COOKIES=1

# IA des annonces de revente : auto (IA locale si elle tourne) ou template
AI_PROVIDER=auto
AI_MODEL=gemma3:4b
