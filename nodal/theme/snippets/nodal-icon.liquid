{%- comment -%}
  Icônes NODAL (trait 1,5 px, couleur héritée).
  Usage : {% render 'nodal-icon', icon: 'truck' %}
  Valeurs : truck, return, made, shield, clock
{%- endcomment -%}
{%- case icon -%}
  {%- when 'truck' -%}
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M1 5h10v8H1zM11 8h4l2 3v2h-6"/><circle cx="4.5" cy="14" r="1.5"/><circle cx="13.5" cy="14" r="1.5"/></svg>
  {%- when 'return' -%}
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M3 9a6 6 0 1 0 2-4.5M3 2v3h3"/></svg>
  {%- when 'made' -%}
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M2 16h14M4 16V8l5-4 5 4v8M7 16v-4h4v4"/></svg>
  {%- when 'shield' -%}
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M9 1l7 3v5c0 4-3 7-7 8-4-1-7-4-7-8V4z"/><path d="M6 9l2 2 4-4"/></svg>
  {%- when 'clock' -%}
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><circle cx="9" cy="9" r="7.5"/><path d="M9 4.5V9l3 2"/></svg>
{%- endcase -%}
