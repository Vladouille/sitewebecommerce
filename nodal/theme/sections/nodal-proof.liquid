{%- comment -%}
  NODAL — « Oui, ça tient. » Frein n°1. Vidéo en plan-séquence, sans coupe.
  Sur une fiche produit, la vidéo du métachamp nodal.test_video du produit est prioritaire.
{%- endcomment -%}
{%- liquid
  assign vid = section.settings.video
  if product and product.metafields.nodal.test_video.value != blank
    assign vid = product.metafields.nodal.test_video.value
  endif
-%}
<section class="nd nd-section nd-rule nd-proof" aria-labelledby="nd-proof-{{ section.id }}">
  <div class="nd-wrap">
    <h2 class="nd-h2" id="nd-proof-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="nd-lead">{{ section.settings.text }}</p>{%- endif -%}
    {% render 'nodal-video', video: vid, label: 'Vidéo du test de charge : plan fixe, poids visible, sans coupe', loop: false %}
    {%- if section.blocks.size > 0 -%}
      <div class="nd-specs">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}><b>{{ block.settings.value }}</b><span>{{ block.settings.label }}</span></div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "NODAL · Ça tient",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Oui, ça tient." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "On charge chaque modèle à 3 fois sa charge maximale avant de le vendre. Regarde." },
    { "type": "video", "id": "video", "label": "Vidéo du test de charge", "info": "Sur une fiche produit, le métachamp nodal.test_video du produit la remplace." }
  ],
  "blocks": [
    { "type": "spec", "name": "Chiffre", "settings": [
      { "type": "text", "id": "value", "label": "Valeur", "default": "×3" },
      { "type": "text", "id": "label", "label": "Légende", "default": "marge de test" }
    ] }
  ],
  "presets": [{
    "name": "NODAL · Ça tient",
    "blocks": [
      { "type": "spec", "settings": { "value": "×3", "label": "marge de test" } },
      { "type": "spec", "settings": { "value": "[matière]", "label": "matière modules" } },
      { "type": "spec", "settings": { "value": "Chêne", "label": "massif, France" } }
    ]
  }]
}
{% endschema %}
