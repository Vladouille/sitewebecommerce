{%- comment -%} NODAL — FAQ en accordéon natif (<details>), sans JavaScript. {%- endcomment -%}
<section class="nd nd-section nd-rule" aria-labelledby="nd-faq-{{ section.id }}">
  <div class="nd-wrap">
    <h2 class="nd-h2" id="nd-faq-{{ section.id }}">{{ section.settings.heading }}</h2>
    <div class="nd-faq">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="nd-faq__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NODAL · FAQ",
  "settings": [{ "type": "text", "id": "heading", "label": "Titre", "default": "Questions" }],
  "blocks": [
    { "type": "qa", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "Question" },
      { "type": "richtext", "id": "answer", "label": "Réponse", "default": "<p>Réponse.</p>" }
    ] }
  ],
  "presets": [{
    "name": "NODAL · FAQ",
    "blocks": [
      { "type": "qa", "settings": { "question": "Ça tient vraiment un casque de moto ?", "answer": "<p>Chaque module affiche sa charge maximale et il est testé à 3 fois cette valeur. Un casque de moto pèse 1,3 à 1,8 kg.</p>" } },
      { "type": "qa", "settings": { "question": "J'ai des murs en placo, c'est possible ?", "answer": "<p>Oui. La boîte contient des chevilles pour placo, en plus des chevilles béton et brique. Le guide de pose précise la charge totale par type de mur.</p>" } },
      { "type": "qa", "settings": { "question": "Ça va abîmer mon mur ?", "answer": "<p>Deux trous de 6 mm, rebouchables en 2 minutes si tu déménages. Rien d'autre ne touche le mur.</p>" } },
      { "type": "qa", "settings": { "question": "Je le reçois quand ?", "answer": "<p>Chaque rail est fabriqué à la commande. La date de livraison estimée est affichée sur chaque fiche produit et dans ton panier.</p>" } },
      { "type": "qa", "settings": { "question": "Et si ça ne me plaît pas une fois posé ?", "answer": "<p>Tu as 30 jours pour le renvoyer, même monté. [À COMPLÉTER : frais de retour à la charge du client ou offerts.]</p>" } },
      { "type": "qa", "settings": { "question": "Comment j'entretiens le chêne ?", "answer": "<p>Un chiffon sec. Une fois par an, un peu d'huile si tu veux raviver la teinte.</p>" } }
    ]
  }]
}
{% endschema %}
