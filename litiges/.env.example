# Copie ce fichier en `.env.local` et remplis les valeurs. Ne committe JAMAIS `.env.local`.
# Étape 1.1 et 1.2 : aucune variable n'est encore nécessaire.
# Les variables suivantes seront utilisées aux étapes suivantes :

# URL publique du site (ex. https://ton-domaine.fr)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (région UE, Francfort) — étape 1.5
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # secret serveur uniquement, jamais exposé au navigateur

# Brevo (emails transactionnels) — étape 1.4
# BREVO_API_KEY=
# ALERT_EMAIL_TO=

# Admins autorisés au back-office (emails séparés par des virgules) — étape 1.6
# ADMIN_EMAILS=
